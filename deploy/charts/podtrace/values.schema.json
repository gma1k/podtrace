{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "podtrace Helm chart values",
  "description": "Configuration schema for the podtrace chart. See values.yaml for inline documentation of every field.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "affinity": {
          "type": "object"
        },
        "alerting": {
          "type": "object",
          "properties": {
            "allowInsecureWebhook": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "webhookURL": {
              "type": "string"
            },
            "webhookURLSecretRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "btfMode": {
          "type": "string",
          "enum": [
            "auto",
            "host",
            "file",
            "embedded"
          ]
        },
        "btfSource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "hostPath": {
              "type": "string",
              "pattern": "^/.*"
            }
          }
        },
        "dnsFullAnswers": {
          "type": "boolean"
        },
        "dnsPacketCapture": {
          "type": "boolean"
        },
        "eventBufferSize": {
          "type": "integer"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "usdt": {
          "type": "boolean"
        },
        "rolloutMaxUnavailable": {
          "description": "A count or a percentage, e.g. 2 or \"25%\". Empty keeps the Kubernetes default.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^([0-9]+%?)?$"
            }
          ]
        },
        "uprobeMulti": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object",
          "description": "Continuous metrics plane. See docs/continuous-metrics.md.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "excludeNamespaces": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            },
            "seriesBudget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000,
              "description": "0 uses the built-in default."
            },
            "nativeHistograms": {
              "type": "boolean"
            },
            "semanticConventions": {
              "type": "boolean"
            },
            "attributeCardinality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "labels": {
              "type": "object",
              "properties": {
                "pod": {
                  "type": "boolean"
                },
                "process": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "kernelAggregation": {
              "type": "boolean"
            },
            "filesystem": {
              "type": "boolean"
            },
            "inspections": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "alerts": {
                  "type": "boolean"
                },
                "budget": {
                  "type": "integer",
                  "minimum": 0
                },
                "holdTime": {
                  "type": "string"
                },
                "thresholds": {
                  "type": "object"
                }
              }
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "statusReportInterval": {
          "type": "string"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "effect": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              }
            }
          }
        },
        "allowedImageRepos": {
          "type": "array",
          "description": "Extra repositories a TracerConfig may point the agent and session Job image at; \"*\" disables the check.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "continuousProfiling": {
          "type": "boolean"
        },
        "sockOpsRTT": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "crds": {
      "type": "object",
      "properties": {
        "adopt": {
          "type": "boolean"
        },
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        },
        "labelerImage": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "object",
      "properties": {
        "exporterconfig": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "insecure": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            },
            "samplePercent": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "synthesizeSpans": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "description": "Reserved by Helm for parent-chart globals."
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "appVersionDigest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "namespace": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "create": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "NetworkPolicy `from` peers."
        },
        "inspectFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "NetworkPolicy `from` peers."
        },
        "allowAPIServerToInspect": {
          "type": "boolean"
        },
        "allowAPIServerProxy": {
          "type": "boolean"
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "affinity": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "extraEnv": {
          "type": "array"
        },
        "leaderElect": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "objectStore": {
          "type": "object",
          "properties": {
            "crossNamespaceAmbientCredentials": {
              "type": "boolean"
            },
            "endpointAllowlist": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "replicas": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "activeDeadlineOffset": {
          "type": "string"
        },
        "backoffLimit": {
          "type": "integer"
        },
        "maxConcurrentSessionsPerNode": {
          "type": "integer"
        },
        "maxDuration": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "integer",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "ttlSecondsAfterFinished": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "tracerConfig": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "description": "Name of the cluster-scoped TracerConfig. Empty means \"default\"."
        },
        "sidecarUploader": {
          "type": "boolean"
        },
        "retainOnUninstall": {
          "type": "boolean"
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "redactDNSNames": {
              "type": "boolean"
            },
            "customRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9!#$%&'*+.^_|~-]+$"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "properties": {
        "caBundle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]*$",
          "description": "Base64-encoded PEM CA bundle that signed the webhook serving certificate. Required unless certSource is cert-manager."
        },
        "certManager": {
          "type": "object",
          "properties": {
            "issuerRef": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "certSource": {
          "type": "string",
          "enum": [
            "cert-manager",
            "manual",
            "self-signed"
          ],
          "description": "cert-manager issues the serving certificate. manual (self-signed is an alias) uses your own Secret <fullname>-webhook-tls and needs webhook.caBundle."
        },
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
