#######################################################################
# REFERENCE LIST ONLY. THIS FILE IS NOT LOADED AT RUNTIME.
#
# Podtrace does not read .env files. Nothing in the codebase parses one.
# Copying this file to .env will have no effect whatsoever.
#
# It exists so you can see every environment variable podtrace reads,
# with its default, in one place. To actually set them, use:
#
#   CLI              your shell, e.g. PODTRACE_LOG_LEVEL=debug podtrace ...
#   Helm             env entries in deploy/charts/podtrace values
#   Operator         the pod spec it generates, or the TracerConfig CRD
#
# Full documentation, including parsing rules, is in
# docs/configuration.md. Booleans accept any strconv.ParseBool spelling
# (true/TRUE/1/t and their negatives), with one exception: the escape
# hatches at the bottom of this file require the literal 1 and ignore
# the value true entirely.
#######################################################################

### Core runtime
PODTRACE_LOG_LEVEL=info
PODTRACE_VERSION=
PODTRACE_IMAGE=ghcr.io/gma1k/podtrace
PODTRACE_EVENT_BUFFER_SIZE=10000
PODTRACE_EVENT_BATCH_SIZE=100
PODTRACE_BATCH_INTERVAL=10ms
PODTRACE_SHUTDOWN_TIMEOUT=5s
PODTRACE_RESOURCE_MONITOR_INTERVAL=5s
PODTRACE_CONTAINER_PID=1
PODTRACE_MANAGEMENT_PORT=0
PODTRACE_GRPC_PORT=50051
PODTRACE_ARTIFACT_BASE=

### eBPF and kernel
PODTRACE_BPF_OBJECT=
PODTRACE_BTF_FILE=
PODTRACE_RING_BUFFER_SIZE_KB=2048
PODTRACE_BPF_HASH_MAP_SIZE=4096
PODTRACE_BPF_LOG_LEVEL=
PODTRACE_BPF_LOG_SIZE=
PODTRACE_USDT_ENABLED=true
PODTRACE_DNS_PAYLOAD_ENABLED=true
PODTRACE_DNS_PACKET_CAPTURE=true
PODTRACE_CRITICAL_PATH=true
PODTRACE_CRITICAL_PATH_WINDOW_MS=500
PODTRACE_CAPTURE_HEADERS=

### Host paths
PODTRACE_CGROUP_BASE=/sys/fs/cgroup
PODTRACE_PROC_BASE=/proc
PODTRACE_DOCKER_BASE=/var/lib/docker/containers
PODTRACE_CONTAINERD_BASE=/var/lib/containerd
PODTRACE_CONTAINERD_OVERLAY_PATTERN=
PODTRACE_CONTAINERD_NATIVE_PATTERN=
PODTRACE_LDSOCONF_BASE=/etc
PODTRACE_BINARY_SEARCH_PATHS=

### Kubernetes integration
PODTRACE_K8S_ENRICHMENT_ENABLED=true
PODTRACE_K8S_USE_INFORMERS=true
PODTRACE_K8S_INFORMERS_SYNC_TIMEOUT_SEC=
PODTRACE_K8S_API_TIMEOUT=500ms
PODTRACE_K8S_CACHE_TTL=300
PODTRACE_MAX_TARGET_PODS=256
PODTRACE_SPAWN_NAMESPACE=
PODTRACE_SPAWN_SA=
PODTRACE_NODE_LOCAL=
PODTRACE_BOOTSTRAP_IMAGE=
PODTRACE_BOOTSTRAP_TC_NAME=

### CRI resolution
PODTRACE_CRI_RESOLVE=true
PODTRACE_CRI_ENDPOINT=
PODTRACE_CRI_CGROUP_FIELDS=
PODTRACE_CRI_ALLOW_PODMAN=

### Metrics
PODTRACE_METRICS_ADDR=127.0.0.1:3000
PODTRACE_METRICS_LABEL_LIMIT=200
PODTRACE_METRICS_POD_LABEL_LIMIT=500
PODTRACE_METRICS_ENABLE_PPROF=false

### Tracing exporters
PODTRACE_TRACING_ENABLED=false
PODTRACE_TRACING_SAMPLE_RATE=1.0
PODTRACE_TRACING_SYNTHESIZE_SPANS=false
PODTRACE_TRACING_EXPORTER_TIMEOUT=10s
PODTRACE_OTLP_ENDPOINT=http://localhost:4318
PODTRACE_JAEGER_ENDPOINT=
PODTRACE_SPLUNK_ENDPOINT=
PODTRACE_SPLUNK_TOKEN=
PODTRACE_DATADOG_ENDPOINT=http://localhost:8126/v0.4/traces
PODTRACE_DATADOG_API_KEY=
PODTRACE_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
PODTRACE_EXPORTER_CREDENTIAL=
PODTRACE_EXPORTER_CREDENTIAL_FILE=

### Alerting
PODTRACE_ALERTING_ENABLED=false
PODTRACE_ALERT_EVENTS_ENABLED=true
PODTRACE_ALERT_MIN_SEVERITY=warning
PODTRACE_ALERT_WEBHOOK_URL=
PODTRACE_ALERT_SLACK_WEBHOOK_URL=
PODTRACE_ALERT_SLACK_CHANNEL=#alerts
PODTRACE_ALERT_SPLUNK_ENABLED=false
PODTRACE_ALERT_DEDUP_WINDOW=5m
PODTRACE_ALERT_RATE_LIMIT=10
PODTRACE_ALERT_HTTP_TIMEOUT=10s
PODTRACE_ALERT_MAX_RETRIES=3
PODTRACE_ALERT_MAX_PAYLOAD_SIZE=1048576
PODTRACE_ALERT_WARN_PCT=80
PODTRACE_ALERT_CRIT_PCT=90
PODTRACE_ALERT_EMERG_PCT=95

### Profiling
PODTRACE_PROFILING_ENABLED=false
PODTRACE_PROFILING_PPROF_PORTS=6060,8080,8081,9090,2345
PODTRACE_PROFILING_AUTO_TRIGGER_MS=500
PODTRACE_PROFILING_DEFAULT_DURATION=30s
PODTRACE_PROFILING_MAX_CONCURRENT=1

### Caches
PODTRACE_CACHE_MAX_SIZE=10000
PODTRACE_CACHE_TTL_SECONDS=3600
PODTRACE_CACHE_EVICTION_THRESHOLD=0.9
PODTRACE_PROCESS_CACHE_EVICTION_RATIO=0.9
PODTRACE_PID_CACHE_EVICTION_RATIO=0.9

### Rate limiting, sampling, resilience
PODTRACE_RATE_LIMIT_PER_SEC=10
PODTRACE_RATE_LIMIT_BURST=20
PODTRACE_EVENT_SAMPLING_RATE=100
PODTRACE_ERROR_BACKOFF_ENABLED=true
PODTRACE_CIRCUIT_BREAKER_ENABLED=true

### Analysis thresholds
PODTRACE_TCP_LATENCY_SPIKE_MS=100
PODTRACE_TCP_REALTIME_MS=10
PODTRACE_UDP_LATENCY_SPIKE_MS=100
PODTRACE_CONNECT_LATENCY_MS=1
PODTRACE_HIGH_ERROR_COUNT_THRESHOLD=100
PODTRACE_SPIKE_RATE_THRESHOLD=5.0
PODTRACE_MIN_LATENCY_FOR_STACK_NS=1000000
PODTRACE_MAX_EVENTS_FOR_STACKS=10000
PODTRACE_MAX_BYTES_FOR_BANDWIDTH=10485760

### CLI output limits
PODTRACE_TOP_TARGETS_LIMIT=5
PODTRACE_TOP_FILES_LIMIT=5
PODTRACE_TOP_URLS_LIMIT=5
PODTRACE_TOP_PROCESSES_LIMIT=10
PODTRACE_TOP_STATES_LIMIT=10
PODTRACE_MAX_STACK_TRACES_LIMIT=5
PODTRACE_MAX_STACK_FRAMES_LIMIT=5
PODTRACE_MAX_OOM_KILLS_DISPLAY=5
PODTRACE_MAX_BURSTS_DISPLAY=3
PODTRACE_TIMELINE_BUCKETS=5
PODTRACE_MAX_CONNECTION_TARGETS=10

### Privacy
PODTRACE_REDACT_PII=false
PODTRACE_REDACT_CUSTOM_RULES=
PODTRACE_REDACT_DNS_NAMES=

### Object store
PODTRACE_OBJECTSTORE_CREDENTIALS_DIR=

### Escape hatches.
PODTRACE_ALLOW_BROAD_CGROUP=
PODTRACE_ALLOW_ROOT_CGROUP=
PODTRACE_ALLOW_CGROUP_FILTER_DISABLE=false
PODTRACE_DISABLE_USERSPACE_CGROUP_FILTER=
PODTRACE_DISABLE_ATTRIBUTION_CORRELATOR=
PODTRACE_FORCE_DISABLE_L7=
PODTRACE_SKIP_SELINUX_CHECK=
PODTRACE_SKIP_LOCKDOWN_CHECK=
PODTRACE_METRICS_INSECURE_ALLOW_ANY_ADDR=false
PODTRACE_OTLP_INSECURE=false
PODTRACE_EXPORTER_INSECURE=false
PODTRACE_ALERT_SPLUNK_ALLOW_HTTP=false
PODTRACE_ALERT_WEBHOOK_ALLOW_HTTP=false